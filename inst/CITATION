## The citation year is PINNED to the release year, not derived from the
## current date. DESCRIPTION has no Date field, so the previous fallback
## made the same package version cite as a different year every calendar
## year, and drift from the bibtex block published in README.md.
year <- 2023
note <- sprintf("R package version %s", meta$Version)

bibentry(
  bibtype  = "Misc",
  header   = "To cite the softballR R package in publications, use:",
  key      = "king_softballR",
  author   = person("Tyson", "King", email = "tmking4@ncsu.edu"),
  title    = "softballR: Easily Accessible College Softball Data.",
  url      = "https://github.com/sportsdataverse/softballR",
  year     = year,
  note     = note,
  textVersion = paste0(
    "Tyson King (", year, "). softballR: Easily Accessible College Softball ",
    "Data. ", note, ". Retrieved from https://github.com/sportsdataverse/softballR"
  )
)
